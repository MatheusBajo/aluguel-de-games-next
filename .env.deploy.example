# =============================================================================
# .env.deploy.example — copie pra .env.deploy e preencha
# =============================================================================
# O .env.deploy NÃO vai pro git (já está no .gitignore).
# NENHUMA SENHA fica aqui: no modo ssh usa chave, no modo ftp usa o Keychain.
# =============================================================================

# ssh  = melhor (rsync incremental, sobe só o que mudou). Precisa de SSH
#        liberado no hPanel: Avançado → Acesso SSH.
# ftp  = funciona em qualquer plano. Mais lento, precisa de `brew install lftp`.
METHOD=ssh

# Onde o site mora no servidor. Na Hostinger quase sempre é public_html.
REMOTE_DIR=/home/SEU_USUARIO/domains/alugueldegames.com.br/public_html

SITE_URL=https://www.alugueldegames.com.br

# ---------------------------------------------------------------- SSH -------
# Pegue em: hPanel → Avançado → Acesso SSH (IP, porta, usuário)
SSH_HOST=000.000.000.000
SSH_USER=u000000000
SSH_PORT=65002

# ---------------------------------------------------------------- FTP -------
# Só usados se METHOD=ftp. Pegue em: hPanel → Arquivos → Contas FTP
FTP_HOST=ftp.alugueldegames.com.br
FTP_USER=u000000000.alugueldegames

# Nome do item no Keychain do macOS onde a senha do FTP está guardada.
# Guarde a senha assim (ele pergunta a senha sem mostrar na tela):
#   security add-generic-password -s 'hostinger-ftp-aluguel' -a 'SEU_FTP_USER' -w
FTP_KEYCHAIN_ITEM=hostinger-ftp-aluguel
